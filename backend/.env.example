NODE_ENV=development
PORT=3000

MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

JWT_SECRET=
JWT_EXPIRES_IN=7d

CORS_ORIGINS=http://localhost:4200

APP_URL=http://localhost:4200

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Avatar uploads. The browser uploads straight to Cloudinary using a signature this API
# generates, so the file never passes through the server and the secret never leaves it.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=snapcart/avatars

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-at-least-8-chars
