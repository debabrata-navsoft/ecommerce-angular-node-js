# Template only — copy to .env and fill that in. This file is committed, so it must never
# contain real credentials. `.env` is gitignored and is the file the server actually loads.

NODE_ENV=development
PORT=3000

# MongoDB connection string. Always include the database name in the path.
# Local:  mongodb://127.0.0.1:27017/ecommerce
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# Sign the auth JWTs. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required — the server refuses to boot without it. Use the full random value: a short or
# guessable secret lets anyone mint a token with role=admin.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated origins allowed to send credentialed requests (the Angular app).
CORS_ORIGINS=http://localhost:4200

# Razorpay. Without these, /api/payments/* returns 503 and only 'cod' orders work.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Created/updated by `npm run seed`. Must be a real email address — it is the admin login.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-at-least-8-chars
