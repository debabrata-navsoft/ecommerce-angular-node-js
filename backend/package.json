{
  "name": "ecommerce-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Node.js + Express + MongoDB (Mongoose) backend for the ecommerce-ssr Angular app",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed/seed.js",
    "seed:reset": "node src/seed/seed.js --reset"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^10.0.10",
    "razorpay": "^2.9.5"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true
  }
}
